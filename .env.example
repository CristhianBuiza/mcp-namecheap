# Namecheap > Profile > Tools > API Access
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
# Defaults to NAMECHEAP_API_USER
NAMECHEAP_USERNAME=
# Must be whitelisted in API Access. Auto-detected via api.ipify.org if empty.
NAMECHEAP_CLIENT_IP=
# Use api.sandbox.namecheap.com (needs a separate sandbox account)
NAMECHEAP_SANDBOX=false
# Allow register_domain / renew_domain (they charge your balance)
NAMECHEAP_ENABLE_PURCHASES=false
